# Geometry code names a lot of coordinates, and naming them is the point --
# see the "descriptive names" rule this project is written to. A function that
# places four holes and two slots legitimately holds more locals than pylint's
# default fifteen, and collapsing them into arrays to satisfy the check makes
# the geometry harder to read, not easier.
[DESIGN]
max-locals = 24
max-args = 8
max-positional-arguments = 8

[MESSAGES CONTROL]
# The scripts are run as files from the repo root with scripts/ on the path,
# not installed as a package, so pylint cannot resolve the sibling imports.
disable = import-error

[SIMILARITIES]
# R0801 is off, and only for one reason worth writing down. Four Fusion scripts
# open with the same dozen lines that walk app.documents looking for a document
# by name prefix. Factoring it would mean a shared module that only ever runs
# inside Fusion, which nothing here can execute or test, to save four copies of
# a loop. The duplication that could be removed safely -- the ray caster and the
# mesh report block, both local -- already has been, into mesh_helpers.py.
min-similarity-lines = 100
